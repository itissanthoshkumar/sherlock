# Copy to .env and fill in. A READ-ONLY MySQL user is enough — the app only runs
# the SELECT in lookup.sql. (User accounts live in users.yaml, not the database.)

# --- Read-only LMS/LOS database (can also be set in-app: admin -> Database) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=
DB_NAME=your_database

# --- Session cookie signing ---------------------------------------------------
# Generate a stable value:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_MAX_AGE=28800

# --- MongoDB (users, roles, master data, history, API logs) -------------------
# MONGO_MOCK=true uses in-memory mongomock (dev only; not durable). For a real
# durable DB set MONGO_MOCK=false and point MONGO_URI at your server/cluster:
#   local:  mongodb://127.0.0.1:27017
#   atlas:  mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_MOCK=false
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=dpd_early_warning
# First-run admin seeded when the users collection is empty.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- Account Aggregator availability rule -------------------------------------
# AA-enabled = source in AA_SOURCE_VALUES AND created_date strictly after the
# cutoff. (engrow uses DIGITAL=AA, MANUAL/blank=not AA. 14/04/26 = 14 Apr 2026.)
AA_SOURCE_VALUES=DIGITAL
AA_FETCH_CUTOFF=2026-04-14
# Lookup column that carries the Digitap parent txn id (main_txn_id). It is NOT
# in the base query yet — add the column to lookup.sql and name it here.
LOOKUP_TXN_COLUMN=main_txn_id

# --- Digitap bank-data (period fetch) -----------------------------------------
# Keep DIGITAP_MOCK=true to run the full 3-call flow with canned responses.
DIGITAP_MOCK=true
DIGITAP_BASE_URL=https://svc.digitap.ai
DIGITAP_INITIATE_PATH=/bank-data/initiate_periodic_fetch
DIGITAP_STATUS_PATH=/bank-data/statuscheck
DIGITAP_RETRIEVE_PATH=/bank-data/retrievereport

# Two Basic-auth credential pairs (from the curls):
#   INIT  -> initiate_periodic_fetch
#   DATA  -> statuscheck + retrievereport
DIGITAP_INIT_USER=
DIGITAP_INIT_PASS=
DIGITAP_DATA_USER=
DIGITAP_DATA_PASS=

# Auto statuscheck+retrieve this many seconds after initiate (UI also has manual).
DIGITAP_AUTO_DELAY=10
DIGITAP_HTTP_TIMEOUT=30

# Response field mapping (tweak once live responses are seen)
DIGITAP_CHILD_ID_PATH=txn_id
DIGITAP_STATUS_FIELD_PATH=status
DIGITAP_STATUS_CODE_PATH=code
DIGITAP_STATUS_READY_VALUES=success,completed,ready,data_ready,dataready
DIGITAP_BALANCE_PATH=report.summary.balance
DIGITAP_CURRENCY_PATH=report.summary.currency

# --- Decision logic -----------------------------------------------------------
DPD_BUFFER=0

# --- Dev convenience ----------------------------------------------------------
# Skip MySQL and return canned multi-account rows. Keep false in real envs.
LOOKUP_MOCK=false
